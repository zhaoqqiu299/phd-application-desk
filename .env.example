# PhD Application Desk settings. This file is git-ignored: never commit it.
# Run locally with:  npm run dev
# On Vercel, enter these same names under Project → Settings → Environment Variables instead.

# Required: your Hopscotch Labs API key
HOPSCOTCH_API_KEY=paste-your-hopscotch-key-here

# Model to answer with (any id Hopscotch lists, e.g. anthropic/claude-sonnet-5-5 is cheaper)
MODEL=anthropic/claude-opus-5-5

# Only used by server.mjs (not Vercel)
PORT=3000
DATA_FILE=./data.json
# Set when the page is hosted separately (e.g. GitHub Pages) and calls this server
ALLOWED_ORIGIN=

# Leave as is unless Hopscotch gives you a different endpoint
HOPSCOTCH_API_URL=https://api.hopscotchlabs.ai/v1/chat/completions
